{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-pro",
  "default_agent": "sanctuary",
  "instructions": ["docs/internal/agent-primer.md"],
  "shell": "powershell",
  "autoupdate": "notify",
  "plugin": [
    "opencode-supermemory",
    "opencode-background-agents"
  ],
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 15000,
    "reserved": 8000
  },
  "agent": {
    "build": { "disable": true }
  },
  "permission": {
    "bash": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "webfetch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "skill_find": "allow",
    "skill_resource": "allow",
    "websearch": "allow",
    "describe_image": "allow",
    "apply_patch": "allow"
  }
}
