{
  "name": "prettyk-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Клиентский редактор JSON-манифестов PrettyK DSL (SecOps)",
  "scripts": {
    "generate:keywords": "python ../orchestrator/tools/export_keywords.py",
    "generate:method-ids": "python ../orchestrator/tools/export_method_ids.py",
    "generate:fuzz-pack": "python ../orchestrator/tools/export_fuzz_pack.py",
    "generate": "npm run generate:keywords && npm run generate:method-ids && npm run generate:fuzz-pack",
    "dev": "vite",
    "dev:auth": "npx tsx auth-server.ts",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "test:auth": "npx tsx scripts/test-auth.ts",
    "dev:terminal": "npx tsx terminal-gateway.ts",
    "dev:full": "npx concurrently \"npm run dev:auth\" \"npm run dev\"",
    "dev:all": "npx concurrently \"npm run dev:auth\" \"npm run dev:terminal\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.cjs",
    "screenshot:results": "node scripts/screenshot.cjs",
    "test": "vitest run",
    "test:fast": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^2.8.10",
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.12.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.3",
    "antd": "^5.29.3",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^1.33.0",
    "marked": "^14.1.4",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "path-to-regexp": "^6.3.0",
    "pg": "^8.23.0",
    "ra-data-json-server": "^5.15.0",
    "react": "^18.3.1",
    "react-admin": "^5.15.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
